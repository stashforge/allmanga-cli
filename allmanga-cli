def _enforce_cache_limits(cache_dir):
    try:
        max_bytes = 100 * 1024 * 1024
        target_bytes = 80 * 1024 * 1024
        files = []
        total_size = 0
        for f in os.listdir(cache_dir):
            p = os.path.join(cache_dir, f)
            if os.path.isfile(p):
                st = os.stat(p)
                files.append((st.st_atime, p, st.st_size))
                total_size += st.st_size
                
        if total_size > max_bytes:
            files.sort(key=lambda x: x[0])  # Oldest access time first
            for atime, p, size in files:
                try:
                    os.remove(p)
                    total_size -= size
                    if total_size <= target_bytes:
                        break
                except Exception:
                    pass
    except Exception:
        pass

def _mark_poster_download(url_hash):
    with _poster_download_lock:
        if url_hash in _active_downloads:
            return False
        _active_downloads.add(url_hash)
