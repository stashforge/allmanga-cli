                pending_osd_msg = ""
                _exit_player_screen()
                
                # Smart Auto-Scrobble & Timestamping (80% OR <150s remaining)
                auto_scrobbled = playback_looks_complete(
                    result, percent, time_pos, duration, played_seconds
