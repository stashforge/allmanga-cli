def _loading_frame():
    frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    return frames[int(time.time() * 10) % len(frames)]

def _loading_line(msg, width=80):
    msg = sanitize_terminal_text(msg)
    frame = _loading_frame()
    if len(msg) > width - 4:
        msg = msg[:max(1, width - 7)] + "..."
    return f"\033[36m{frame} {msg}\033[0m"

def _get_key(fd):
    """Read one keypress from raw fd. Returns semantic string."""
    ch = os.read(fd, 1)
    if ch == b"\x1b":                       # escape sequence
        if select.select([fd],[],[],0.2)[0]:
            ch2 = os.read(fd, 1)
            if ch2 == b"[" or ch2 == b"O":
                ch3 = os.read(fd, 1)
                if ch3 == b"A": return "UP"
                if ch3 == b"B": return "DOWN"
                if ch3 == b"C": return "RIGHT"
                if ch3 == b"D": return "LEFT"
                if ch2 == b"[":
                    if ch3 == b"Z": return "SHIFT_TAB"
                if ch3 == b"H": return "HOME"
                if ch3 == b"F": return "END"
                # sequences like [1~, [3~, [5~, [6~
                rest = ch3
                while not (b"\x40" <= rest[-1:] <= b"\x7e"):
                    rest += os.read(fd, 1)
                if rest == b"3~": return "DELETE"
                return "UNKNOWN"
            return "ESC"                     # lone ESC after short wait
        return "ESC"                         # lone ESC, nothing followed
    if ch in (b"\r", b"\n"):   return "ENTER"
    if ch == b"\x7f":          return "BACKSPACE"
    if ch == b"\x08":          return "BACKSPACE"
    if ch == b"\x03":          return "CTRL_C"
    if ch == b"\x15":          return "CTRL_U"   # clear line
    if ch == b"\t":            return "TAB"
    return ch.decode("utf-8", errors="ignore")

def _match(query, text):
    """
    Case-insensitive substring match.
    Returns (start, end) of match in plain text, or None.
    """
    if not query:
        return (0, 0)
    lo = text.lower()
    q  = query.lower()
    i  = lo.find(q)
    if i == -1:
        return None
    return (i, i + len(q))

def _clear_terminal_images():
    # Kitty deletion is harmless on terminals that do not implement it.
    return "\033_Ga=d\x1b\\"

def _render_item(raw, query, selected, max_w=0):
    """
    Build the colored display string for one list item.
    raw    : original option string (may contain ANSI from caller)
    query  : current search string
    selected: bool
    max_w  : max visible width; 0 = no truncation
    """
    plain = sanitize_terminal_text(raw)
    # Truncate if too long
    if max_w > 0:
        plain = _truncate_display(plain, max_w)
    dimmed = "\033[38;5;244m" in raw or "\033[2m" in raw
    if selected:
        base = _C_SEL
    elif dimmed:
        base = "\033[38;5;244m"
    else:
        base = _C_NORMAL

    if not query:
        return f"{base}{plain}{_RST}"

    m = _match(query, plain)
    if m is None:
        return f"{base}{plain}{_RST}"
    s, e = m
    if s == e:
        return f"{base}{plain}{_RST}"
    before = plain[:s]
    middle = plain[s:e]
    after  = plain[e:]
    hl = _C_MATCH if not selected else f"\033[1;97m\033[4m"
    return f"{base}{before}{_RST}{hl}{middle}{_RST}{base}{after}{_RST}"

_PROXY_HOP_HEADERS = {
    "connection",
    "keep-alive",
    "proxy-authenticate",
    "proxy-authorization",
    "te",
    "trailer",
    "transfer-encoding",
    "upgrade",
}

def _proxy_filtered_headers(headers):
    filtered = {}
    for key, value in (headers or {}).items():
        name = str(key or "").strip()
        text = str(value or "")
        if (
            not name
            or name.casefold() in _PROXY_HOP_HEADERS
            or name.casefold() in ("host", "content-length")
            or any(ord(ch) < 32 for ch in name + text)
        ):
            continue
        filtered[name] = text
    return filtered

def _proxy_path_authorized(request_path, secret_path):
    return urllib.parse.urlsplit(str(request_path or "")).path == secret_path

def _proxy_method_allowed(method):
    return str(method or "").upper() in ("GET", "HEAD")

def _proxy_range_header(value):
    value = str(value or "").strip()
    return (
        value
        if value and re.fullmatch(r"bytes=\d*-\d*(?:,\d*-\d*)*", value)
        else ""
    )

def _proxy_response_headers(headers):
    connection_tokens = set()
    connection = headers.get("Connection", "") if headers else ""
    for token in str(connection).split(","):
        token = token.strip().casefold()
        if token:
            connection_tokens.add(token)
    blocked = _PROXY_HOP_HEADERS | connection_tokens
    return [
        (key, value)
        for key, value in (headers.items() if headers else [])
        if str(key).casefold() not in blocked
    ]

def _new_proxy_secret_path():
    return f"/{uuid.uuid4().hex}/stream.mp4"

def start_local_proxy(target_url, referer, headers=None, timeout=15):
    import http.server

    validate_http_url(target_url)
    secret_path = _new_proxy_secret_path()
    forwarded_headers = _proxy_filtered_headers(headers)

    class ProxyHandler(http.server.BaseHTTPRequestHandler):
        def log_message(self, format, *args): pass # Silence logs

        def _reject_method(self):
            self.send_response(405)
            self.send_header("Allow", "GET, HEAD")
            self.send_header("Content-Length", "0")
            self.end_headers()

        def _proxy(self, method):
            if not _proxy_method_allowed(method):
                self._reject_method()
                return
            if not _proxy_path_authorized(self.path, secret_path):
                self.send_error(404)
                return
            req = urllib.request.Request(target_url, method=method)
            req.add_header("User-Agent", "Mozilla/5.0")
            if referer: req.add_header("Referer", referer)
            for key, value in forwarded_headers.items():
                req.add_header(key, value)
            range_header = _proxy_range_header(self.headers.get("Range", ""))
            if range_header:
                req.add_header("Range", range_header)

            try:
                with urllib.request.urlopen(
                    req,
                    context=SSL_CTX_SECURE,
                    timeout=max(1, float(timeout)),
                ) as resp:
                    validate_http_url(resp.geturl())
                    self.send_response(resp.status)
                    for k, v in _proxy_response_headers(resp.headers):
                        self.send_header(k, v)
                    self.end_headers()
                    if method == "GET":
                        while chunk := resp.read(65536):
                            try: self.wfile.write(chunk)
                            except Exception: break
            except Exception as exc:
                debug_warn("Local proxy upstream request failed", exc)
                try: self.send_error(502, "Upstream stream unavailable")
                except Exception: pass

        def do_GET(self):
            self._proxy("GET")

        def do_HEAD(self):
            self._proxy("HEAD")

        do_POST = _reject_method
        do_PUT = _reject_method
        do_DELETE = _reject_method
        do_OPTIONS = _reject_method
        do_PATCH = _reject_method

    class ThreadedHTTPServer(http.server.ThreadingHTTPServer):
        daemon_threads = True
        block_on_close = False

    server = ThreadedHTTPServer(('127.0.0.1', 0), ProxyHandler)
    port = server.server_address[1]
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return f"http://127.0.0.1:{port}{secret_path}", server

def start_local_content_server(content, filename, content_type):
    import http.server

    payload = content.encode("utf-8") if isinstance(content, str) else bytes(content)
    safe_name = re.sub(r"[^A-Za-z0-9._-]", "_", str(filename or "content"))
    content_type = str(content_type or "application/octet-stream")
    if not re.fullmatch(r"[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+", content_type):
        content_type = "application/octet-stream"
    secret_path = f"/{uuid.uuid4().hex}/{safe_name}"

    class ContentHandler(http.server.BaseHTTPRequestHandler):
        def log_message(self, format, *args): pass

        def _serve(self, include_body):
            if not _proxy_path_authorized(self.path, secret_path):
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            if include_body:
                self.wfile.write(payload)

        def do_GET(self):
            self._serve(True)

        def do_HEAD(self):
            self._serve(False)

        def _reject_method(self):
            self.send_response(405)
            self.send_header("Allow", "GET, HEAD")
            self.send_header("Content-Length", "0")
            self.end_headers()

        do_POST = _reject_method
        do_PUT = do_POST
        do_DELETE = do_POST
        do_OPTIONS = do_POST
        do_PATCH = do_POST

    class ThreadedHTTPServer(http.server.ThreadingHTTPServer):
        daemon_threads = True
        block_on_close = False

    server = ThreadedHTTPServer(("127.0.0.1", 0), ContentHandler)
    port = server.server_address[1]
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return f"http://127.0.0.1:{port}{secret_path}", server

def stop_local_proxy(server):
    if not server:
        return
    try:
        server.shutdown()
    except Exception as e:
        debug_warn("Local proxy shutdown failed", e)
    try:
        server.server_close()
    except Exception as e:
        debug_warn("Local proxy close failed", e)

def replace_active_local_proxy(server=None):
    global _active_local_proxy
    with _local_proxy_lock:
        previous = _active_local_proxy
        _active_local_proxy = server
    if previous is not None and previous is not server:
        stop_local_proxy(previous)
    return server

def cleanup_active_local_proxy():
    global _active_local_proxy
    with _local_proxy_lock:
        server = _active_local_proxy
        _active_local_proxy = None
    stop_local_proxy(server)

atexit.register(cleanup_active_local_proxy)

def _wrap_title(text, cols, max_lines=2):
    """Wrap text to fit in max_lines of cols width. Truncate with … if needed."""
    if _display_width(text) <= cols:
        return text
    lines = []
    rem = text
    for i in range(max_lines):
        if not rem:
            break
        if i == max_lines - 1:
            lines.append(_truncate_display(rem, cols))
        else:
            line, rem = _split_display_prefix(rem, cols)
            lines.append(line)
            
    return "\n".join(lines)

def _extract_title_parts(title):
    """Extract (clean_title, season, show_type) from a title string.
    e.g. 'Youkoso... Season 2 (TV)' -> ('Youkoso...', '2', 'TV')
    """
    if not title:
        return ("", "", "")
    t = title
    # Extract type: (TV), (Movie), (OVA), (ONA), (Special), (TV Short), etc.
    show_type = ""
    m = re.search(r'\s*\(([A-Z][A-Za-z ]+)\)\s*$', t)
    if m:
        show_type = m.group(1)
        t = t[:m.start()].strip()
    # Extract season
    season = ""
    m = re.search(r'(?i)\s*(?::?\s*|-\s*)season\s*(\d+)(?:[:\-]?\s*.*)?$', t)
    if m:
        season = m.group(1)
        t = t[:m.start()].strip()
    else:
        # Try patterns like "2nd Season", "3rd Season"
        m = re.search(r'(?i)\s*(?::?\s*|-\s*)(\d+)(?:st|nd|rd|th)\s+season\s*$', t)
        if m:
            season = m.group(1)
            t = t[:m.start()].strip()
    return (t, season, show_type)

def get_display_titles(show, main_title):
    romaji = show.get("name")
    if romaji: romaji = romaji.strip()
    english = show.get("englishName")
    if english: english = english.strip()
    
    alt = ""
    if english and romaji and english.lower() != romaji.lower():
        alt = romaji if main_title.lower() == english.lower() else english
        
    if not alt and show.get("altNames"):
        excl = main_title.lower()
        cands = [n.strip() for n in show["altNames"] if n and n.strip().lower() != excl]
        
        non_lat_pat = re.compile(r'[^\x00-\x7F]')
        romaji_pat = re.compile(r'\b(no|wo|wa|ga|ni|de|to|na|shi|tsu|chi|shita|datta|naru|suru|kara)\b', re.IGNORECASE)
        pinyin_pat = re.compile(r'\b(dou|po|cang|qiong|nian|fan|zhi|lan|yuan|qi|sha|xiao|zhan|chen|tang|yao|xuan|jing|feng|lei|ming|hong|ling|wang|liu|zhang|yang|wei|jun|xue|long|shen|wu|zhou|dao|tian|bei|nan|dong|xi)\b', re.IGNORECASE)
        
        eng_l, rom_l, pin_l, nat_l = [], [], [], []
        
        for n in cands:
            if non_lat_pat.search(n):
                nat_l.append(n)
            elif romaji_pat.search(n):
                rom_l.append(n)
            elif pinyin_pat.search(n):
                pin_l.append(n)
            else:
                eng_l.append(n)
                
        if eng_l: alt = eng_l[0]
        elif rom_l: alt = rom_l[0]
        elif pin_l: alt = pin_l[0]
        elif nat_l: alt = nat_l[0]
        
    if not alt:
        native = show.get("nativeName")
        if native and native.strip().lower() != main_title.lower():
            alt = native.strip()
            
    return sanitize_terminal_text(alt)

def get_show_display_title(show, fallback="Unknown", sync_enabled=None):
    if not show:
        return sanitize_terminal_text(fallback)
    if show.get("_anilist_context"):
        sync_enabled = True
    if sync_enabled is None:
        sync_enabled = bool(show.get("_sync_enabled"))
    if sync_enabled:
        title = show.get("_display_name") or show.get("name") or fallback
    else:
        title = show.get("_allanime_name") or show.get("name") or fallback
    return sanitize_terminal_text(title)

def formatTime(secs):
    if not secs: return ""
    d, s = divmod(secs, 86400)
    h, s = divmod(s, 3600)
    m, _ = divmod(s, 60)
    pieces = []
    if d > 0: pieces.append(f"{int(d)}d")
    if h > 0: pieces.append(f"{int(h)}h")
    if m > 0 and len(pieces) < 2: pieces.append(f"{int(m)}m")
    return " ".join(pieces[:2])

def set_next_airing_fields(show, next_air):
    if not show or not next_air:
        return
    show["_next_airing_ep"] = next_air.get("episode")
    rem = next_air.get("timeUntilAiring")
    show["_next_airing_time"] = rem
    try:
        show["_next_airing_at"] = int(time.time()) + int(rem)
    except (TypeError, ValueError):
        pass

def _positive_int(value):
    try:
        value = int(value)
        return value if value > 0 else None
    except (TypeError, ValueError):
        return None

def _format_ep_progress(label, progress, total):
    try:
        progress = max(0, int(progress))
    except (TypeError, ValueError):
        return ""
    C_D = "\033[38;5;248m"
    label_color = "\033[36m" if label == "AL" else "\033[38;5;244m"
    prefix = f"{label_color}{label}{C_D} EP"
    return f"{prefix} {progress}/{total}" if total else f"{prefix} {progress}"

def format_progress(anime):
    total = _positive_int(anime.get("episodeCount"))
    sync_enabled = bool(anime.get("_sync_enabled"))
    local_progress = anime.get("_local_progress")
    al_progress = anime.get("_anilist_progress")
    authority = anime.get("_progress_authority")
    if anime.get("_sync_conflict") and local_progress is not None:
        return _format_ep_progress("LOCAL", local_progress, total)
    if sync_enabled and al_progress is not None:
        return _format_ep_progress("AL", al_progress, total)
    if authority == "AL" and al_progress is not None:
        return _format_ep_progress("AL", al_progress, total)
    if local_progress is not None:
        return _format_ep_progress("LOCAL", local_progress, total)
    return ""

def format_available_episodes(anime, ttype="sub"):
    if str(anime.get("status") or "").upper() != "RELEASING":
        return ""

    next_episode = _positive_int(anime.get("_next_airing_ep"))
    if next_episode:
        return f"Avail {max(0, next_episode - 1)}"

    available = anime.get("availableEpisodes", {}).get(ttype)
    try:
        available = int(available)
    except (TypeError, ValueError):
        available = None
    if available is not None and available >= 0:
        return f"Avail {available}"

    try:
        progress = max(0, int(anime.get("_anilist_progress") or 0))
    except (TypeError, ValueError):
        progress = 0
    return f"Avail {progress}"

def format_next_airing(anime, now=None):
    episode = anime.get("_next_airing_ep")
    airing_at = anime.get("_next_airing_at")
    if not episode or not airing_at:
        return ""
    try:
        remaining = int(float(airing_at)) - int(time.time() if now is None else now)
    except (TypeError, ValueError):
        return ""
    if remaining <= 0:
        return f"EP {episode} aired"
    return f"EP {episode} in {formatTime(remaining)}"

def format_years(start_year, end_year, status=None):
    start_year = _positive_int(start_year)
    end_year = _positive_int(end_year)
    status = str(status or "").upper()
    if start_year and end_year and start_year != end_year:
        return f"{start_year} - {end_year}"
    if start_year and end_year == start_year:
        return str(start_year)
    if start_year and status == "RELEASING":
        return f"{start_year} -"
    if start_year:
        return str(start_year)
    return "TBA"

def should_refresh_anilist(anime, now=None):
    if str(anime.get("status") or "").upper() != "RELEASING":
        return False
    airing_at = anime.get("_next_airing_at")
    if not airing_at:
        return bool(anime.get("_next_airing_ep") or anime.get("_next_airing_time"))
    try:
        return int(float(airing_at)) <= int(time.time() if now is None else now)
    except (TypeError, ValueError):
        return True

def _anilist_status_label(anime):
    C_D = "\033[38;5;248m"
    status = str(anime.get("status") or "").upper()
    show_anilist_status = anime.get("_sync_enabled") or anime.get("_anilist_context")
    al_list = str(anime.get("_anilist_list") or "").upper().replace(" ", "_") if show_anilist_status else ""
    if al_list in ("CURRENT", "WATCHING"): return f"\033[32mWATCHING{C_D}"
    if al_list == "COMPLETED": return f"\033[36mCOMPLETED{C_D}"
    if al_list in ("PLANNING", "PLAN_TO_WATCH"): return f"\033[33mPLAN TO WATCH{C_D}"
    if al_list == "DROPPED": return f"\033[31mDROPPED{C_D}"
    if al_list == "PAUSED": return f"\033[35mPAUSED{C_D}"
    if al_list in ("REPEATING", "REWATCHING"): return f"\033[32mREWATCHING{C_D}"
    if status == "RELEASING": return f"\033[32mAIRING{C_D}"
    return ""

def format_info_metadata_line(anime, ttype="sub", now=None, override_ep_str=None):
    C_D = "\033[38;5;248m"
    details = []
    status_label = _anilist_status_label(anime)
    if override_ep_str:
        label = "AL" if anime.get("_sync_enabled") else "LOCAL"
        label_color = "\033[36m" if label == "AL" else "\033[38;5;244m"
        progress = f"{label_color}{label}{C_D} {override_ep_str}"
    else:
        progress = format_progress(anime)
    available = format_available_episodes(anime, ttype)
    next_airing = format_next_airing(anime, now)
    typ = str(anime.get("type") or "TV").upper()
    start_year = anime.get("airedStart", {}).get("year") if anime.get("airedStart") else None
    end_year = anime.get("airedEnd", {}).get("year") if anime.get("airedEnd") else None
    years = format_years(start_year, end_year, anime.get("status"))
    score = anime.get("score")
    score_str = f"★ {score}" if score else "★ -"

    if status_label: details.append(status_label)
    if progress: details.append(progress)
    if available: details.append(available)
    if next_airing:
        details.append(f"\033[38;5;220m{next_airing}{C_D}")
    if typ: details.append(typ)
    if years: details.append(years)
    details.append(score_str)
    return " • ".join(details)

