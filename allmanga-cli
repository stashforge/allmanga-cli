#!/usr/bin/env python3
"""Compatibility launcher for the packaged AllManga CLI."""

import sys
import runpy
from pathlib import Path

from allmanga_cli.cli.main import run as _run


# Load an isolated compatibility namespace, matching the old standalone script.
_app_namespace = runpy.run_path(
    str(Path(__file__).resolve().parent / "allmanga_cli" / "app.py")
)
globals().update({
    name: value for name, value in _app_namespace.items()
    if not name.startswith("__")
})


if __name__ == "__main__":
    raise SystemExit(_run())
