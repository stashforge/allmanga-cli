def download_episode(title, ep, stream, download_dir=""):
    audio_url = stream.get("audio_url", "")
    downloader = "ffmpeg" if audio_url else "yt-dlp"
    if not shutil.which(downloader):
        if audio_url:
            err("ffmpeg is required to download separate DASH video and audio.")
        else:
            err("yt-dlp is not installed. Install it to download episodes.")
        return False
    try:
        url = validate_stream_url(stream["link"])
        if audio_url:
            audio_url = validate_stream_url(audio_url)
        referer = validate_optional_referer(stream.get("referer", ""))
    except ValueError:
        err("Download rejected an unsafe stream URL.")
        return False
    safe_title = "".join(c for c in title if c.isalnum() or c in " -_").strip()
    filename = f"{safe_title} - Episode {ep}.mp4"
    download_dir = os.path.expanduser(str(download_dir or "").strip())
    if download_dir:
        target_dir = os.path.join(download_dir, safe_title)
        try:
            os.makedirs(target_dir, exist_ok=True)
        except Exception as e:
            err(f"Could not create download folder: {e}")
            return False
        filename = os.path.join(target_dir, filename)
    
    print(f"\n{CYAN}[Download]{RESET} {filename}")
    
    if audio_url:
        cmd = [
            "ffmpeg", "-nostdin", "-y",
            "-i", url, "-i", audio_url,
            "-map", "0:v:0", "-map", "1:a:0",
            "-c", "copy", filename,
        ]
    else:
        cmd = ["yt-dlp", url, "-o", filename]
        if referer:
            cmd.extend(["--add-header", f"Referer:{referer}"])
        
    try:
        subprocess.run(cmd, check=True)
        print(f"\n{GREEN}[Success]{RESET} Download complete.")
        return True
    except Exception as e:
        print(f"\n{RED}[Error]{RESET} Download failed: {e}")
        return False

VIDEO_EXTS = {".mp4", ".mkv", ".webm", ".avi", ".mov", ".m4v"}

def _natural_key(s):
    return [int(p) if p.isdigit() else p.lower() for p in re.split(r"(\d+)", str(s))]

def scan_download_library(download_dir):
    base = os.path.expanduser(str(download_dir or "").strip())
    if not base or not os.path.isdir(base):
        return base, []

    groups = {}
    for root, _, files in os.walk(base):
        rel_root = os.path.relpath(root, base)
        for name in files:
            ext = os.path.splitext(name)[1].lower()
            if ext not in VIDEO_EXTS:
                continue
            path = os.path.join(root, name)
            if rel_root == ".":
                group_name = "Downloads"
            else:
                group_name = rel_root.split(os.sep, 1)[0]
            groups.setdefault(group_name, []).append(path)

    library = []
    for group_name, paths in groups.items():
        library.append({
            "name": group_name,
            "files": sorted(paths, key=lambda p: _natural_key(os.path.basename(p))),
        })
    return base, sorted(library, key=lambda g: _natural_key(g["name"]))

def play_local_video(path, player="mpv"):
    path = os.path.abspath(os.path.expanduser(path))
    if not os.path.exists(path):
        err("Downloaded file no longer exists.")
        return False

    title = os.path.basename(path)
    if is_termux():
        chosen = player if player in PLAYERS else "mpv"
        pkg, act_cls = PLAYERS.get(chosen, PLAYERS["mpv"])
        file_uri = "file://" + urllib.request.pathname2url(path)
        cmd = ["am", "start",
               "-a", "android.intent.action.VIEW",
               "-d", file_uri, "-t", "video/*",
               "-n", f"{pkg}/{act_cls}",
               "--es", "title", title]
    else:
        chosen = "vlc" if player == "vlc" else "mpv"
        if not shutil.which(chosen):
            err(f"{chosen} is not installed.")
            return False
        cmd = [chosen, path]

    try:
        subprocess.run(cmd, check=False)
        return True
    except Exception as e:
        err(f"Could not open downloaded file: {e}")
        return False

