    search_error = ""
    while True:
        query = tui_pick(
            "Match AllAnime",
            [],
            header_fn=_manual_match_input_header(al_title, search_error),
            return_query_on_enter=True,
            initial_query=query,
            is_search=True,
            help_dict=search_input_help()
        )
        if query == -2 or not query:
            return None
        query = str(query).strip()
