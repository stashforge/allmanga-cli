def _poster_footer_line(show, default_text, width):
    def trim(value):
        return value[:width - 1] + "…" if len(value) > width else value

    def split_replaced_footer(value):
        if "│" in default_text:
            _, right = default_text.split("│", 1)
            return value, f"  │{right}"
        return value, ""

    def status_line(value, color, loading=False):
        left, right = split_replaced_footer(value)
        if loading:
            left = f"{_loading_frame()} {left}"
        plain = left + right
        if len(plain) > width:
            keep_right = max(0, width - len(left) - 1)
            right = right[:keep_right] + ("…" if keep_right else "")
        return f"{color}{left}{_RST}{_C_HINT}{right}{_RST}"

    default_line = f"{_C_HINT}{trim(default_text)}{_RST}"
    if not globals().get("SHOW_IMAGE", False) or not show:
        return default_line
    with _poster_lock:
        status = show.get("_poster_status")
        status_time = float(show.get("_poster_status_time", 0) or 0)

    if status == "loading":
        return status_line("Loading cover", "\033[36m", loading=True)

    if status_time and time.time() - status_time > 3:
        return default_line

    if status == "failed":
        return status_line("Cover failed", "\033[38;5;203m")
    if status == "missing":
        return status_line("Cover unavailable", "\033[38;5;214m")
    if status == "no_chafa":
        return status_line("Cover needs chafa", "\033[38;5;214m")
    return default_line

def _poster_needs_tick(show):
    if not globals().get("SHOW_IMAGE", False) or not show:
        return False
    with _poster_lock:
        return show.get("_poster_status") == "loading"

MAX_COVER_BYTES = 8 * 1024 * 1024
POSTER_WIDTH = 12
POSTER_HEIGHT = 8

def _chafa_cover_command(path):
    # Chafa selects the best terminal protocol. Relative mode keeps the native
    # image anchored to the reserved cell container chosen by the TUI.
    return [
        "chafa",
        "--probe=off",
        "--relative=on",
        "--animate=off",
        f"--size={POSTER_WIDTH}x{POSTER_HEIGHT}",
        "--stretch",
        "--colors=full",
        path,
    ]

def _poster_uses_native_protocol(raw):
    raw = str(raw or "")
    return any(marker in raw for marker in ("\033_G", "\033Pq", "\033]1337;File="))

def _poster_symbol_lines(raw, height, columns):
    if not raw or _poster_uses_native_protocol(raw):
        return []
    text = str(raw)
    # Chafa with --relative=on uses ESC D (Index) instead of newlines to
    # separate rows.  Split on both so symbol art renders correctly.
    text = text.replace("\x1bD", "\n")
    # Strip cursor-left sequences (e.g. \033[12D) that chafa emits to
    # return the cursor to column 1 — the TUI handles positioning itself.
    text = re.sub(r"\033\[\d+D", "", text)
    lines = text.splitlines()[:height]
    # Append SGR reset so background colors don't bleed across the full
    # terminal width when the line is shorter than the terminal.
    return [_fit_terminal_line(line, columns) + "\033[0m" for line in lines]

def validate_http_url(url):
    if not isinstance(url, str) or any(ord(ch) < 32 for ch in url):
        raise ValueError("Invalid URL")
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme.lower() not in ("http", "https") or not parsed.hostname:
        raise ValueError("Only HTTP(S) URLs are allowed")
    if parsed.username is not None or parsed.password is not None:
        raise ValueError("URLs with embedded credentials are not allowed")
    return url

def validate_stream_url(url):
    """Accept only credential-free HTTP(S) media and extractor destinations."""
    return validate_http_url(url)

def validate_optional_referer(referer):
    if not referer:
        return ""
    return validate_http_url(referer)

def is_supported_image(data):
    if data.startswith(b"\xff\xd8\xff"):
        return True
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return True
    if data.startswith((b"GIF87a", b"GIF89a")):
        return True
    if len(data) >= 12 and data.startswith(b"RIFF") and data[8:12] == b"WEBP":
        return True
    if len(data) >= 12 and data[4:8] == b"ftyp" and data[8:12] in (b"avif", b"avis"):
        return True
    return False

def fetch_cover_bytes(url, max_bytes=MAX_COVER_BYTES):
    validate_http_url(url)
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, context=SSL_CTX_SECURE, timeout=5) as response:
        final_url = response.geturl() if hasattr(response, "geturl") else url
        validate_http_url(final_url)
        content_length = response.headers.get("Content-Length")
        if content_length:
            try:
                if int(content_length) > max_bytes:
                    raise ValueError("Cover image is too large")
            except ValueError as exc:
                if str(exc) == "Cover image is too large":
                    raise
        chunks = []
        total = 0
        while True:
            chunk = response.read(min(65536, max_bytes - total + 1))
            if not chunk:
                break
            total += len(chunk)
            if total > max_bytes:
                raise ValueError("Cover image is too large")
            chunks.append(chunk)
    data = b"".join(chunks)
    if not is_supported_image(data):
        raise ValueError("Unsupported cover image format")
    return data

def _get_poster(show):
    if not globals().get("SHOW_IMAGE", False):
        return None
    globals()["_hovered_show_obj"] = show

    if "thumbnail" not in show or not show.get("thumbnail"):
        _set_poster_status(show, "missing")
        return ""
    if not shutil.which("chafa"):
        _set_poster_status(show, "no_chafa")
        return ""
    with _poster_lock:
        if show.get("_poster_failed"):
            pass
        else:
            poster_raw = show.get("_poster_raw")
            if poster_raw is not None:
                show["_poster_status"] = "ready"
                show["_poster_status_time"] = time.time()
                return poster_raw
    with _poster_lock:
        poster_failed = show.get("_poster_failed")
    if poster_failed:
        _set_poster_status(show, "failed")
        return ""

    url = show.get("thumbnail")
    cache_dir = cover_cache_dir()
    url_hash = hashlib.sha256(url.encode('utf-8')).hexdigest()[:32]
    cached_path = os.path.join(cache_dir, f"{url_hash}.jpg")
    
    # 1. If cached, serve it instantly
    if os.path.exists(cached_path):
        os.utime(cached_path, None)  # Update access time for LRU
        try:
            proc = subprocess.run(
                _chafa_cover_command(cached_path),
                capture_output=True, text=True, timeout=10
            )
            if proc.returncode == 0 and proc.stdout.strip():
                raw = proc.stdout.rstrip("\n")
                with _poster_lock:
                    show["_poster_raw"] = raw
                    show["_poster_status"] = "ready"
                    show["_poster_status_time"] = time.time()
                return raw
            else:
                with _poster_lock:
                    show["_poster_failed"] = True
                _set_poster_status(show, "failed")
                return ""
        except Exception:
            with _poster_lock:
                show["_poster_failed"] = True
            _set_poster_status(show, "failed")
            return ""

    # 2. If not cached, trigger a background async download so we don't freeze the UI
    _set_poster_status(show, "loading")
    if _mark_poster_download(url_hash):
        
        def _download_thread():
            time.sleep(0.3)
            # If the user scrolled past this show before 300ms elapsed, gracefully abort the download!
            if globals().get("_hovered_show_id") != show.get("_id"):
                _unmark_poster_download(url_hash)
                return
                
            tmp_path = None
            try:
                os.makedirs(cache_dir, exist_ok=True)
                img_data = fetch_cover_bytes(url)

                tmp_fd, tmp_path = tempfile.mkstemp(suffix=".jpg", prefix="allmanga_tmp_")
                with os.fdopen(tmp_fd, "wb") as f:
                    f.write(img_data)
                    
                if shutil.which("magick"):
                    converted = subprocess.run(
                        ["magick", tmp_path, "-resize", "400x600", cached_path],
                        capture_output=True,
                        timeout=10,
                    )
                    if converted.returncode != 0:
                        raise RuntimeError("ImageMagick could not decode cover")
                elif shutil.which("ffmpeg"):
                    converted = subprocess.run(
                        ["ffmpeg", "-y", "-i", tmp_path, "-vf", "scale=400:-1", cached_path],
                        capture_output=True,
                        timeout=10,
                    )
                    if converted.returncode != 0:
                        raise RuntimeError("ffmpeg could not decode cover")
                else:
                    shutil.copy2(tmp_path, cached_path)
                    
                _enforce_cache_limits(cache_dir)
                
                # Fetch chafa output right away
                proc = subprocess.run(
                    _chafa_cover_command(cached_path),
                    capture_output=True, text=True, timeout=10
                )
                if proc.returncode == 0 and proc.stdout.strip():
                    with _poster_lock:
                        show["_poster_raw"] = proc.stdout.rstrip("\n")
                        show["_poster_status"] = "ready"
                        show["_poster_status_time"] = time.time()
                else:
                    with _poster_lock:
                        show["_poster_failed"] = True
                    _set_poster_status(show, "failed")
                    
                global _needs_redraw
                _needs_redraw = True
            except Exception:
                with _poster_lock:
                    show["_poster_failed"] = True
                _set_poster_status(show, "failed")
                _needs_redraw = True
            finally:
                if tmp_path:
                    try: os.remove(tmp_path)
                    except Exception: pass
                _unmark_poster_download(url_hash)

        threading.Thread(target=_download_thread, daemon=True).start()

    return ""

