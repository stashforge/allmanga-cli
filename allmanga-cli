def decrypt_tobeparsed(b64):
    key = hashlib.sha256(b"Xot36i3lK3:v1").hexdigest()
    try:
        enc = base64.b64decode(b64)
    except Exception:
        return None
    if len(enc) < 30: return None
    iv  = enc[1:13].hex() + "00000002"
    ct  = enc[13:len(enc)-16]
    cmd = ["openssl","enc","-d","-aes-256-ctr",
           "-K",key,"-iv",iv,"-nosalt","-nopad"]
    try:
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, _ = p.communicate(input=ct)
        return out.decode("utf-8",errors="ignore") if p.returncode==0 else None
    except Exception:
        return None

def decrypt_url(hex_str):
    r = []
    for i in range(0, len(hex_str), 2):
        r.append(CIPHER.get(hex_str[i:i+2], hex_str[i:i+2]))
    return "".join(r).replace("/clock","/clock.json")

