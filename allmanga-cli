}

def anilist_menu_loading_frame(status, rows, columns):
    options = list(ANILIST_LIST_STATUSES)
    selected = next(
        (
            index for index, label in enumerate(options)
            if ANILIST_LIST_STATUSES[label] == status
        ),
        -1,
    )
    header_lines = anilist_menu_header().splitlines()
    item_count = len(options)
    padding = max(0, rows - item_count - 1 - len(header_lines))
    out = [""] * padding
    item_width = max(20, columns - 3)

    for index in range(item_count - 1, -1, -1):
        is_selected = index == selected
        pointer = f"{_C_PTR}\u276f{_RST}" if is_selected else " "
        label = _render_item(options[index], "", is_selected, max_w=item_width)
        out.append(_fit_terminal_line(f"{pointer} {label}", columns))

    prompt = f"{_C_PROMPT}AniList Lists \u276f{_RST}"
    count = f"{_C_COUNT}{item_count}/{item_count}{_RST}"
    used = _display_width(f"{prompt}  {count}")
    separator_width = max(1, columns - used - 2)
    separator = f" {_C_HINT}{'\u2500' * separator_width}{_RST}"
    out.append(_fit_terminal_line(f"{prompt}  {count}{separator}", columns))
    out.extend(_fit_terminal_line(line, columns) for line in header_lines)
    return _absolute_terminal_frame(out, rows, columns)

