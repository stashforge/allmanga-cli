def expand_wixmp(url):
    m = re.search(r'/,([^/]*),/mp4', url)
    if not m: return {"original": url}
    base = re.sub(r'\.urlset.*$','',url.replace("repackager.wixmp.com/",""))
    return {r: base.replace(m.group(0), f'/{r}/mp4')
            for r in m.group(1).split(',') if r}

