def fetch_anilist_media(token, media_id):
    q = """
    query($id: Int) {
      Media(id: $id, type: ANIME) {
        id
        title { romaji english native }
        format
        episodes
        status
        averageScore
        startDate { year month day }
        endDate { year month day }
        nextAiringEpisode { episode timeUntilAiring }
        mediaListEntry { progress status }
      }
    }
    """
    req = urllib.request.Request("https://graphql.anilist.co", method="POST")
    req.add_header("Content-Type", "application/json")
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("User-Agent", "Mozilla/5.0")
    try:
        data = json.dumps({"query": q, "variables": {"id": int(media_id)}}).encode()
        with anilist_urlopen(req, data) as r:
            media = read_json_response(r).get("data", {}).get("Media")
        return media or {}
    except Exception as e:
        debug_warn("Failed to refresh AniList media", e)
        return {}

def get_anilist_media_id(anime):
    media_id = anime.get("_anilist_id")
    if media_id:
        return media_id
    candidate = anime.get("_id")
    return candidate if str(candidate or "").isdigit() else None

def update_anime_from_anilist_media(anime, media):
    if not anime or not media:
        return False
    anime["_anilist_id"] = str(media.get("id") or get_anilist_media_id(anime) or "")
    titles = media.get("title") or {}
    if titles.get("romaji"):
        anime["_display_name"] = titles["romaji"]
    if titles.get("english"):
        anime["_display_english_name"] = titles["english"]
    if titles.get("native"):
        anime["nativeName"] = titles["native"]
    if media.get("format"):
        anime["type"] = media["format"]
    anime["status"] = media.get("status") or anime.get("status")
    if media.get("episodes") is not None:
        anime["episodeCount"] = media["episodes"]
    if media.get("averageScore") is not None:
        anime["score"] = media["averageScore"] / 10.0
    list_entry = media.get("mediaListEntry") or {}
    if list_entry.get("progress") is not None:
        anime["_anilist_progress"] = max(0, int(list_entry["progress"]))
    if list_entry.get("status"):
        anime["_anilist_list"] = list_entry["status"]
    start = media.get("startDate") or {}
    if start.get("year"):
        anime["airedStart"] = {
            "year": start.get("year"),
            "month": start.get("month"),
            "date": start.get("day"),
        }
    end = media.get("endDate") or {}
    if end.get("year"):
        anime["airedEnd"] = {
            "year": end.get("year"),
            "month": end.get("month"),
            "date": end.get("day"),
        }
    else:
        anime.pop("airedEnd", None)
    next_air = media.get("nextAiringEpisode")
    if next_air:
        set_next_airing_fields(anime, next_air)
    else:
        anime.pop("_next_airing_ep", None)
        anime.pop("_next_airing_time", None)
        anime.pop("_next_airing_at", None)
    return True

def refresh_history_entry_from_anilist(entry, token):
    show = (entry or {}).get("show", {})
    media_id = get_anilist_media_id(show)
    if not token or not media_id or not show.get("_sync_enabled"):
        return False
    media = fetch_anilist_media(token, media_id)
    if not media:
        return False
    changed = update_anime_from_anilist_media(show, media)
    if changed and show.get("_anilist_progress") is not None:
        show["_progress_authority"] = "AL"
    return changed

