#!/usr/bin/env python3
"""Compatibility launcher for the packaged AllManga CLI."""

import sys
import runpy
import os
from pathlib import Path

from allmanga_cli.context import CliFlags, UiState
from allmanga_cli.cli.main import run as _run
from allmanga_cli.ui.picker import tui_pick as _new_tui_pick
from allmanga_cli.ui.fallback import fallback_pick as fallback_tui_pick


# Load an isolated compatibility namespace, matching the old standalone script.
_app_namespace = runpy.run_path(
    str(Path(__file__).resolve().parent / "allmanga_cli" / "app_core.py")
)
globals().update({
    name: value for name, value in _app_namespace.items()
    if not name.startswith("__")
})


def tui_pick(prompt, options, **kwargs):
    tty_fd = -1
    try:
        tty_fd = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        return fallback_tui_pick(
            str(prompt() if callable(prompt) else prompt),
            options,
            return_query_on_enter=kwargs.get("return_query_on_enter", False),
            initial_query=kwargs.get("initial_query", ""),
        )
    finally:
        if tty_fd >= 0:
            os.close(tty_fd)
    return _new_tui_pick(
        CliFlags(show_image=bool(globals().get("SHOW_IMAGE", False))),
        UiState(),
        prompt,
        options,
        **kwargs,
    )


if __name__ == "__main__":
    raise SystemExit(_run())
