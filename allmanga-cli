def _atomic_write_json(path, data, indent=None):
    if is_incognito():
        return False
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(prefix=f".{os.path.basename(path)}.", suffix=".tmp", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=indent)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, path)
        return True
    except Exception:
        try: os.close(fd)
        except Exception: pass
        try: os.remove(tmp_path)
        except Exception: pass
        raise

def write_private_log(filename, content):
    if is_incognito() and not globals().get("DEBUG_MODE", False):
        return None
    os.makedirs(LOG_DIR, mode=0o700, exist_ok=True)
    os.chmod(LOG_DIR, 0o700)
    path = os.path.join(LOG_DIR, os.path.basename(filename))
    fd, tmp_path = tempfile.mkstemp(prefix=".log.", suffix=".tmp", dir=LOG_DIR, text=True)
    try:
        os.chmod(tmp_path, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
            if content and not content.endswith("\n"):
                f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, path)
        os.chmod(path, 0o600)
        return path
    except Exception:
        try: os.close(fd)
        except Exception: pass
        try: os.remove(tmp_path)
        except Exception: pass
        raise

def write_exception_log(filename):
